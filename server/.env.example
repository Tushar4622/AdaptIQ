PORT=8080
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/adaptiq
# Optional TLS override for non-production connections; production always requires verified TLS.
MONGO_TLS=
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ALLOW_LEGACY_REFRESH_TOKENS=false
CLIENT_URL=http://localhost:5173
AI_PROVIDER=groq
GROQ_API_KEY=paste-your-Groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-key-or-leave-empty
FACE_DATA_ENCRYPTION_KEY=generate-a-64-character-hex-key
MFA_ENCRYPTION_KEY=generate-a-64-character-hex-key
FACE_VERIFIER_MODULE=./services/faceVerifierProvider
FACE_VERIFIER_URL=http://127.0.0.1:8090
FACE_VERIFIER_API_TOKEN=generate-a-long-random-service-token
CLAMAV_ENABLED=false
# Required by npm run seed. Use unique passwords satisfying the registration password policy.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=
# Restore requires an explicitly separate, empty destination database.
MONGO_RESTORE_URI=
# Restore drills are restricted to empty databases on loopback MongoDB hosts.
BACKUP_DRILL_SOURCE_URI=
BACKUP_DRILL_TARGET_URI=