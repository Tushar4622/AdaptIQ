{
  "name": "adaptiq-server",
  "version": "1.0.0",
  "description": "AdaptIQ — Express API",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
