    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "file-type": "^22.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "zod": "^4.6.7"
